{
  "name": "geo-cockpit-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "GEO Cockpit desktop launcher (Electron) — starts the FastAPI backend hidden, confirms the Claude connection, and hosts the React cockpit.",
  "author": "Neuron HQ",
  "main": "main.js",
  "scripts": {
    "make-icon": "node scripts/make-icon.js",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.neuronhq.geocockpit",
    "productName": "GEO Cockpit",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GEO Cockpit"
    }
  }
}
